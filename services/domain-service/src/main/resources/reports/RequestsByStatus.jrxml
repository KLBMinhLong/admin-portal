<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="RequestsByStatus"
              language="java"
              pageWidth="842"
              pageHeight="595"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="reportDate" class="java.util.Date"/>
    <parameter name="generatedBy" class="java.lang.String"/>
    <parameter name="filterStatus" class="java.lang.String"/>

    <field name="requestNumber" class="java.lang.String"/>
    <field name="title" class="java.lang.String"/>
    <field name="requestedBy" class="java.lang.String"/>
    <field name="requestedDate" class="java.time.LocalDateTime"/>
    <field name="status" class="java.lang.String"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="currency" class="java.lang.String"/>
    <field name="departmentName" class="java.lang.String"/>
    <field name="itemCount" class="java.lang.Integer"/>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="802" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Danh sách Yêu cầu Mua sắm]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="24" width="400" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="24" width="382" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{generatedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="42" width="802" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{filterStatus}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText><reportElement x="0" y="0" width="90" height="14"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Mã YC]]></text></staticText>
            <staticText><reportElement x="90" y="0" width="170" height="14"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Tiêu đề]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="120" height="14"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Người yêu cầu]]></text></staticText>
            <staticText><reportElement x="380" y="0" width="120" height="14"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Ngày YC]]></text></staticText>
            <staticText><reportElement x="500" y="0" width="100" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Tổng tiền]]></text></staticText>
            <staticText><reportElement x="600" y="0" width="60" height="14"/><textElement textAlignment="Center"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[SL]]></text></staticText>
            <staticText><reportElement x="660" y="0" width="142" height="14"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Phòng ban]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="90" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{requestNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="90" y="0" width="170" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{title}]]></textFieldExpression></textField>
            <textField><reportElement x="260" y="0" width="120" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{requestedBy}]]></textFieldExpression></textField>
            <textField><reportElement x="380" y="0" width="120" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{requestedDate}]]></textFieldExpression></textField>
            <textField><reportElement x="500" y="0" width="100" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression></textField>
            <textField><reportElement x="600" y="0" width="60" height="14"/><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{itemCount}]]></textFieldExpression></textField>
            <textField><reportElement x="660" y="0" width="142" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{departmentName}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="200" height="12"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{generatedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="720" y="0" width="82" height="12"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
