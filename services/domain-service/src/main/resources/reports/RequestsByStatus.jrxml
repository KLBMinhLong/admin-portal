<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="RequestsByStatus"
              language="java"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="reportDate" class="java.util.Date"/>
    <parameter name="generatedBy" class="java.lang.String"/>
    <parameter name="filterStatus" class="java.lang.String"/>

    <field name="requestNumber" class="java.lang.String"/>
    <field name="title" class="java.lang.String"/>
    <field name="requestedBy" class="java.lang.String"/>
    <field name="requestedDate" class="java.time.LocalDateTime"/>
    <field name="status" class="java.lang.String"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="currency" class="java.lang.String"/>
    <field name="departmentName" class="java.lang.String"/>
    <field name="itemCount" class="java.lang.Integer"/>

    <title>
        <band height="64">
            <textField>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="30" width="420" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Ngày xuất: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($P{reportDate})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="462" y="30" width="340" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Người xuất: " + $P{generatedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="48" width="802" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Bộ lọc trạng thái: " + ($P{filterStatus} == null ? "Tất cả" : $P{filterStatus})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="20" backcolor="#E8EEF7"/>
                <graphicElement/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="3" width="90" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Mã YC]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="3" width="180" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tiêu đề]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="3" width="105" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Người yêu cầu]]></text>
            </staticText>
            <staticText>
                <reportElement x="375" y="3" width="105" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ngày yêu cầu]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="3" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Trạng thái]]></text>
            </staticText>
            <staticText>
                <reportElement x="565" y="3" width="102" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tổng tiền]]></text>
            </staticText>
            <staticText>
                <reportElement x="667" y="3" width="45" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[SL]]></text>
            </staticText>
            <staticText>
                <reportElement x="712" y="3" width="90" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Phòng ban]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <line>
                <reportElement x="0" y="19" width="802" height="1" forecolor="#D7DEE8"/>
            </line>
            <textField>
                <reportElement x="0" y="3" width="90" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{requestNumber}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="90" y="3" width="180" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{title}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="3" width="105" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{requestedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="375" y="3" width="105" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{requestedDate} == null ? "" : $F{requestedDate}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="3" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="565" y="3" width="102" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="667" y="3" width="45" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemCount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="712" y="3" width="90" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{departmentName}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <line>
                <reportElement x="0" y="0" width="802" height="1" forecolor="#D7DEE8"/>
            </line>
            <textField>
                <reportElement x="0" y="4" width="300" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filter: " + ($P{filterStatus} == null ? "Tất cả" : $P{filterStatus})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="690" y="4" width="112" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="80">
            <staticText>
                <reportElement x="0" y="20" width="802" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Không có dữ liệu phù hợp với bộ lọc hiện tại]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
