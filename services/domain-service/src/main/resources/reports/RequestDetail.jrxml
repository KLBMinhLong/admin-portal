<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="RequestDetail"
              language="java"
              pageWidth="595"
              pageHeight="842"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="reportDate" class="java.util.Date"/>
    <parameter name="generatedBy" class="java.lang.String"/>

    <field name="requestNumber" class="java.lang.String"/>
    <field name="title" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="requestedBy" class="java.lang.String"/>
    <field name="requestedDate" class="java.time.LocalDateTime"/>
    <field name="departmentName" class="java.lang.String"/>
    <field name="costCenter" class="java.lang.String"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="currency" class="java.lang.String"/>
    <field name="itemsSummary" class="java.lang.String"/>
    <field name="approvalsSummary" class="java.lang.String"/>
    <field name="itemCount" class="java.lang.Integer"/>
    <field name="approvalCount" class="java.lang.Integer"/>

    <title>
        <band height="66">
            <textField>
                <reportElement x="0" y="0" width="555" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="32" width="280" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Ngày xuất: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($P{reportDate})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="32" width="255" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Người xuất: " + $P{generatedBy}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="520" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="120" backcolor="#F7F9FC"/>
                <graphicElement/>
            </rectangle>

            <staticText>
                <reportElement x="16" y="12" width="110" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Mã yêu cầu]]></text>
            </staticText>
            <textField>
                <reportElement x="130" y="12" width="160" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{requestNumber}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="310" y="12" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Trạng thái]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="12" width="139" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="16" y="34" width="110" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tiêu đề]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="130" y="34" width="409" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{title}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="16" y="56" width="110" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Người yêu cầu]]></text>
            </staticText>
            <textField>
                <reportElement x="130" y="56" width="160" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{requestedBy}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="310" y="56" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ngày yêu cầu]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="56" width="139" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{requestedDate} == null ? "" : $F{requestedDate}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="16" y="78" width="110" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Phòng ban]]></text>
            </staticText>
            <textField>
                <reportElement x="130" y="78" width="160" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{departmentName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="310" y="78" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Cost center]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="78" width="139" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{costCenter}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="16" y="100" width="110" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tổng tiền]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="130" y="100" width="160" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="310" y="100" width="85" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tiền tệ]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="100" width="139" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{currency}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="136" width="555" height="16"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Mô tả yêu cầu]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="156" width="555" height="52"/>
                <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6"/>
                <textElement verticalAlignment="Top">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description} == null ? "" : $F{description}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="224" width="555" height="16"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Tóm tắt danh mục hàng hóa]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="244" width="555" height="108"/>
                <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6"/>
                <textElement verticalAlignment="Top">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemsSummary} == null ? "Không có dữ liệu hàng hóa" : $F{itemsSummary}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="368" width="555" height="16"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Tóm tắt luồng phê duyệt]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="388" width="555" height="108"/>
                <box leftPadding="8" rightPadding="8" topPadding="6" bottomPadding="6"/>
                <textElement verticalAlignment="Top">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{approvalsSummary} == null ? "Chưa có bước phê duyệt" : $F{approvalsSummary}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="504" width="555" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Số dòng hàng hóa: " + $F{itemCount} + " | Số bước phê duyệt: " + $F{approvalCount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#D7DEE8"/>
            </line>
            <textField>
                <reportElement x="0" y="4" width="200" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{generatedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="4" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="80">
            <staticText>
                <reportElement x="0" y="20" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Không tìm thấy yêu cầu để lập báo cáo chi tiết]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
